# --- Application ---
APP_NAME=TextileCore
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/textile_factory_ai
# Supabase: Dashboard -> Connect -> "Session pooler" manzili (IPv4 tarmoqda ishlaydi), parolni qo'ying:
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PAROL>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
# Vercel (serverless) uchun "Transaction pooler" (port 6543) + DB_NULL_POOL=true

# --- Supabase Storage (ixtiyoriy: yuklangan rasmlar bucket'da saqlanadi) ---
# Dashboard -> Project Settings -> API Keys. Secret (yoki legacy service_role) kalit — faqat backendda!
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- JWT ---
# Productionda albatta uzun tasodifiy qiymatga almashtiring
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (vergul bilan ajrating) ---
CORS_ORIGINS=http://localhost:5180

# --- Google orqali kirish (ixtiyoriy) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Bo'sh qoldirilsa login sahifasida Google tugmasi ko'rinmaydi.
GOOGLE_CLIENT_ID=

# --- Birinchi SUPER_ADMIN (scripts/create_superadmin.py uchun) ---
SUPERADMIN_EMAIL=admin@textile.ai
SUPERADMIN_PASSWORD=Admin12345
SUPERADMIN_FULL_NAME=Super Admin
